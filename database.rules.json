{
  "rules": {
    "players": {
      ".read": true,
      "$uid": {
        ".write": true,
        ".validate": "newData.hasChildren(['name', 'score', 'pps', 'updatedAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
        },
        "score": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999 && (!data.exists() || newData.val() >= data.val() - 1)"
        },
        "pps": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30"
        },
        "updatedAt": {
          ".validate": "newData.val() === now"
        },
        "$other": { ".validate": false }
      }
    },
    "rooms": {
      ".read": true,
      "$roomId": {
        ".write": true,
        "name":      { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
        "duration":  { ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 600" },
        "status":    { ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'playing' || newData.val() === 'finished')" },
        "host":      { ".validate": "newData.isString()" },
        "hostName":  { ".validate": "newData.isString() && newData.val().length <= 20" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "startedAt": { ".validate": "!newData.exists() || newData.isNumber()" },
        "endAt":     { ".validate": "!newData.exists() || newData.isNumber()" },
        "endedAt":   { ".validate": "!newData.exists() || newData.isNumber()" },
        "players": {
          "$pid": {
            "name":  { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
            "score": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999" },
            "uid":   { ".validate": "newData.isString()" }
          }
        }
      }
    },
    "$other": { ".read": false, ".write": false }
  }
}
